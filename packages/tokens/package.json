{
  "name": "@hue-theme/tokens",
  "version": "0.1.0",
  "type": "module",
  "description": "Portable Huế-inspired semantic design tokens for web and application themes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crafts69guy/hue-theme.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./generated/themes.d.ts",
      "import": "./generated/themes.js",
      "default": "./generated/themes.js"
    },
    "./themes.css": "./generated/themes.css",
    "./themes.json": "./generated/themes.json"
  },
  "files": [
    "generated",
    "README.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun scripts/build.ts --check && tsc --noEmit",
    "prepack": "bun run build && bun run check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.3"
  }
}
