{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Mưa — a deep dark mood shaped by Huế rain at night: midnight navy, rain-blue chrome, and signal colors that cut through the wet.",
  "meta": { "id": "mua", "label": "Huế Mưa", "appearance": "dark" },
  "primitive": {
    "$type": "color",
    "ink": {
      "$value": { "colorSpace": "srgb", "components": [0.0, 0.122, 0.243], "hex": "#001F3E" }
    },
    "stone": {
      "$value": { "colorSpace": "srgb", "components": [0.039, 0.18, 0.322], "hex": "#0A2E52" }
    },
    "pool": {
      "$value": { "colorSpace": "srgb", "components": [0.071, 0.247, 0.431], "hex": "#123F6E" }
    },
    "rain": {
      "$value": { "colorSpace": "srgb", "components": [0.306, 0.478, 0.651], "hex": "#4E7AA6" }
    },
    "drizzle": {
      "$value": { "colorSpace": "srgb", "components": [0.106, 0.227, 0.361], "hex": "#1B3A5C" }
    },
    "paper": {
      "$value": { "colorSpace": "srgb", "components": [0.898, 0.957, 1.0], "hex": "#E5F4FF" }
    },
    "ash": {
      "$value": { "colorSpace": "srgb", "components": [0.616, 0.706, 0.831], "hex": "#9DB4D4" }
    },
    "fog": {
      "$value": { "colorSpace": "srgb", "components": [0.42, 0.506, 0.604], "hex": "#6B819A" }
    },
    "mist": {
      "$value": { "colorSpace": "srgb", "components": [0.549, 0.639, 0.741], "hex": "#8CA3BD" }
    },
    "jade": {
      "$value": { "colorSpace": "srgb", "components": [0.0, 0.812, 0.416], "hex": "#00CF6A" }
    },
    "violet": {
      "$value": { "colorSpace": "srgb", "components": [0.541, 0.482, 1.0], "hex": "#8A7BFF" }
    },
    "gold": {
      "$value": { "colorSpace": "srgb", "components": [1.0, 0.553, 0.0], "hex": "#FF8D00" }
    },
    "vermilion": {
      "$value": { "colorSpace": "srgb", "components": [1.0, 0.353, 0.388], "hex": "#FF5A63" }
    },
    "blue": {
      "$value": { "colorSpace": "srgb", "components": [0.063, 0.714, 0.973], "hex": "#10B6F8" }
    }
  },
  "semantic": {
    "$type": "color",
    "surface": {
      "canvas": { "$value": "{primitive.ink}" },
      "raised": { "$value": "{primitive.stone}" },
      "selected": { "$value": "{primitive.pool}" }
    },
    "text": {
      "primary": { "$value": "{primitive.paper}" },
      "secondary": { "$value": "{primitive.ash}" },
      "accent": { "$value": "{primitive.jade}" }
    },
    "border": {
      "subtle": { "$value": "{primitive.rain}" },
      "faint": { "$value": "{primitive.drizzle}" }
    },
    "accent": {
      "primary": { "$value": "{primitive.jade}" },
      "secondary": { "$value": "{primitive.violet}" }
    },
    "status": {
      "success": { "$value": "{primitive.jade}" },
      "info": { "$value": "{primitive.blue}" },
      "notice": { "$value": "{primitive.violet}" },
      "warning": { "$value": "{primitive.gold}" },
      "error": { "$value": "{primitive.vermilion}" }
    },
    "syntax": {
      "keyword": { "$value": "{primitive.violet}" },
      "string": { "$value": "{primitive.jade}" },
      "number": { "$value": "{primitive.gold}" },
      "function": { "$value": "{primitive.blue}" },
      "comment": { "$value": "{primitive.fog}" },
      "operator": { "$value": "{primitive.vermilion}" },
      "type": { "$value": "{primitive.blue}" },
      "constant": { "$value": "{primitive.gold}" },
      "property": { "$value": "{primitive.paper}" },
      "variable": { "$value": "{primitive.paper}" },
      "punctuation": { "$value": "{primitive.mist}" }
    }
  }
}
