{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Mưa — a light mood built on a pale blue wash, with white panels floating on it like rain-lit paper.",
  "meta": { "id": "mua", "label": "Huế Mưa", "appearance": "light" },
  "primitive": {
    "$type": "color",
    "ink": {
      "$value": { "colorSpace": "srgb", "components": [0.929, 0.953, 0.996], "hex": "#EDF3FE" }
    },
    "stone": {
      "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" }
    },
    "pool": {
      "$value": { "colorSpace": "srgb", "components": [0.69, 0.867, 1.0], "hex": "#B0DDFF" }
    },
    "rain": {
      "$value": { "colorSpace": "srgb", "components": [0.361, 0.482, 0.659], "hex": "#5C7BA8" }
    },
    "drizzle": {
      "$value": { "colorSpace": "srgb", "components": [0.788, 0.863, 0.949], "hex": "#C9DCF2" }
    },
    "paper": {
      "$value": { "colorSpace": "srgb", "components": [0.0, 0.122, 0.243], "hex": "#001F3E" }
    },
    "ash": {
      "$value": { "colorSpace": "srgb", "components": [0.22, 0.294, 0.388], "hex": "#384B63" }
    },
    "fog": {
      "$value": { "colorSpace": "srgb", "components": [0.49, 0.588, 0.757], "hex": "#7D96C1" }
    },
    "mist": {
      "$value": { "colorSpace": "srgb", "components": [0.4, 0.475, 0.545], "hex": "#66798B" }
    },
    "jade": {
      "$value": { "colorSpace": "srgb", "components": [0.0, 0.459, 0.235], "hex": "#00753C" }
    },
    "violet": {
      "$value": { "colorSpace": "srgb", "components": [0.42, 0.184, 0.816], "hex": "#6B2FD0" }
    },
    "gold": {
      "$value": { "colorSpace": "srgb", "components": [0.631, 0.353, 0.0], "hex": "#A15A00" }
    },
    "vermilion": {
      "$value": { "colorSpace": "srgb", "components": [0.761, 0.039, 0.098], "hex": "#C20A19" }
    },
    "blue": {
      "$value": { "colorSpace": "srgb", "components": [0.0, 0.2, 0.788], "hex": "#0033C9" }
    }
  },
  "semantic": {
    "$type": "color",
    "surface": {
      "canvas": { "$value": "{primitive.ink}" },
      "raised": { "$value": "{primitive.stone}" },
      "selected": { "$value": "{primitive.pool}" }
    },
    "text": {
      "primary": { "$value": "{primitive.paper}" },
      "secondary": { "$value": "{primitive.ash}" },
      "accent": { "$value": "{primitive.jade}" }
    },
    "border": {
      "subtle": { "$value": "{primitive.rain}" },
      "faint": { "$value": "{primitive.drizzle}" }
    },
    "accent": {
      "primary": { "$value": "{primitive.jade}" },
      "secondary": { "$value": "{primitive.violet}" }
    },
    "status": {
      "success": { "$value": "{primitive.jade}" },
      "info": { "$value": "{primitive.blue}" },
      "notice": { "$value": "{primitive.violet}" },
      "warning": { "$value": "{primitive.gold}" },
      "error": { "$value": "{primitive.vermilion}" }
    },
    "syntax": {
      "keyword": { "$value": "{primitive.violet}" },
      "string": { "$value": "{primitive.jade}" },
      "number": { "$value": "{primitive.gold}" },
      "function": { "$value": "{primitive.blue}" },
      "comment": { "$value": "{primitive.fog}" },
      "operator": { "$value": "{primitive.vermilion}" },
      "type": { "$value": "{primitive.blue}" },
      "constant": { "$value": "{primitive.gold}" },
      "property": { "$value": "{primitive.paper}" },
      "variable": { "$value": "{primitive.paper}" },
      "punctuation": { "$value": "{primitive.mist}" }
    }
  }
}
