{
  "name": "hue-theme",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "bun@1.2.20",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/tokens build",
    "test": "bun test",
    "check": "bun run --cwd packages/tokens check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "publish:inkdrop": "scripts/publish-inkdrop.sh",
    "publish:inkdrop:dry-run": "scripts/publish-inkdrop.sh --dry-run",
    "quality": "biome check . && bun run check && bun test",
    "ci": "biome ci . && bun run check && bun test && bun run build",
    "publish:yaak": "scripts/publish-yaak.sh",
    "publish:yaak:dry-run": "scripts/publish-yaak.sh --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
